@echo off
cd /d "%~dp0" || exit /b 1
chcp 65001 >nul || exit /b 1
call build.bat app || exit /b 1
if not exist dist mkdir dist || exit /b 1
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $root=(Get-Location).Path; $dist=Join-Path $root 'dist'; $dest=Join-Path $dist 'NexaOS'; $bin='C:\msys64\ucrt64\bin'; $objdump=Join-Path $bin 'objdump.exe'; if(!(Test-Path $objdump)){throw 'objdump.exe nao encontrado em C:\msys64\ucrt64\bin'}; if(Test-Path $dest){Remove-Item $dest -Recurse -Force}; New-Item -ItemType Directory -Path $dest | Out-Null; Copy-Item (Join-Path $root 'build\nexaos.exe') $dest; $database=Join-Path $dest 'database'; New-Item -ItemType Directory -Path $database | Out-Null; Copy-Item (Join-Path $root 'database\schema.sql') $database; Copy-Item (Join-Path $root 'database\dados_exemplo.sql') $database; $data=Join-Path $dest 'data'; $exports=Join-Path $dest 'exports'; New-Item -ItemType Directory -Path $data,$exports | Out-Null; Set-Content (Join-Path $data '.gitkeep') '' -Encoding ascii; Set-Content (Join-Path $exports '.gitkeep') '' -Encoding ascii; $launcher=@('@echo off',('cd /d '+[char]34+[char]37+'~dp0'+[char]34+' || exit /b 1'),'nexaos.exe','if errorlevel 1 pause'); [IO.File]::WriteAllLines((Join-Path $dest 'Iniciar_NexaOS.bat'),$launcher,[Text.Encoding]::ASCII); $readme=@('NexaOS - pacote executável para Windows','','Como executar: dê dois cliques em Iniciar_NexaOS.bat.','','O Windows pode bloquear executáveis não assinados pelo Smart App Control ou','pelo Device Guard. Se isso acontecer, compile o projeto a partir do código-fonte','seguindo as instruções do README.md.','','O banco de dados é criado em data\nexaos.db.'); [IO.File]::WriteAllText((Join-Path $dest 'LEIA-ME.txt'),($readme -join \"`r`n\"),[Text.UTF8Encoding]::new($true)); $fila=[System.Collections.Generic.Queue[string]]::new(); $vistos=@{}; $fila.Enqueue((Join-Path $dest 'nexaos.exe')); while($fila.Count -gt 0){$arquivo=$fila.Dequeue(); $chave=$arquivo.ToLowerInvariant(); if($vistos.ContainsKey($chave)){continue}; $vistos[$chave]=$true; $linhas=& $objdump -p $arquivo 2>&1; if($LASTEXITCODE -ne 0){throw ('objdump falhou: '+$arquivo)}; foreach($linha in $linhas){if($linha -match '^\s*DLL Name:\s*(.+?)\s*$'){$dll=$matches[1]; if($dll -match '^(?i:api-ms-win-|ext-ms-win-)'){continue}; $origem=Join-Path $bin $dll; if(Test-Path $origem -PathType Leaf){$copia=Join-Path $dest $dll; Copy-Item $origem $copia -Force; $fila.Enqueue($origem)}elseif(!(Test-Path (Join-Path (Join-Path $env:WINDIR 'System32') $dll)) -and !(Test-Path (Join-Path (Join-Path $env:WINDIR 'SysWOW64') $dll))){throw ('DLL necessaria nao encontrada: '+$dll)}}}}; $zip=Join-Path $dist 'NexaOS_v1.0.zip'; if(Test-Path $zip){Remove-Item $zip -Force}; Compress-Archive -Path $dest -DestinationPath $zip -Force; if(!(Test-Path $zip)){throw 'Falha ao criar o arquivo ZIP'}" || exit /b 1
